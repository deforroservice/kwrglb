---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.tsx';
import PostCard from '../components/PostCard.astro';
import { projects, posts, stats } from '../data/site';
import { url } from '../lib/url';

const featured = projects.slice(0, 3);
const latest = posts.slice(0, 3);
---

<Base>
  <Hero
    dark
    eyebrow="Research · Partnerships · Funding · Impact"
    title="Bold research for a brighter tomorrow"
    subtitle="Placeholder: we help turn research and innovation into funded, real-world solutions for people and the planet."
  >
    <div class="ctas">
      <a class="btn btn-primary" href={url('research/')}>Explore our approach <span class="arrow">→</span></a>
      <a class="btn btn-secondary btn-on-dark" href={url('projects/')}>Our projects</a>
    </div>
  </Hero>

  <section class="container block">
    <div class="head">
      <div>
        <p class="label">Projects</p>
        <h2>Research builds tomorrow</h2>
      </div>
      <a class="btn btn-tertiary" href={url('projects/')}>View projects <span class="arrow">→</span></a>
    </div>
    <ul class="pcard-grid">
      {featured.map((p) => <li><ProjectCard project={p} /></li>)}
    </ul>
  </section>

  <section class="band">
    <div class="container stats">
      <div class="intro">
        <p class="label">Our network</p>
        <h2>Turning knowledge into real-world impact</h2>
        <p>Placeholder: a sentence about the consortia, institutions and researchers you work with.</p>
      </div>
      <ul>
        {
          stats.map((s) => (
            <li>
              <strong>{s.value}</strong>
              <span>{s.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="container block">
    <div class="head">
      <div>
        <p class="label">Insights</p>
        <h2>Latest publications</h2>
      </div>
      <a class="btn btn-tertiary" href={url('insights/')}>All insights <span class="arrow">→</span></a>
    </div>
    <ul class="posts">
      {latest.map((p) => <li><PostCard post={p} /></li>)}
    </ul>
  </section>
</Base>

<style>
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .block {
    padding-top: 72px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px 24px;
    margin-bottom: 28px;
  }
  .head .label {
    margin: 0 0 6px;
  }
  h2 {
    margin: 0;
    font-size: 40px;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }
  .band {
    margin-top: 72px;
    padding: 64px 0;
    background: var(--band);
  }
  .stats {
    display: grid;
    gap: 32px;
  }
  .stats .label {
    margin: 0 0 6px;
  }
  .intro p:last-child {
    margin: 16px 0 0;
    color: var(--muted);
    max-width: 44ch;
  }
  .stats ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  }
  .stats li {
    border-left: 3px solid var(--green);
    padding-left: 16px;
  }
  .stats strong {
    display: block;
    font-family: var(--display);
    font-size: 56px;
    font-weight: 700;
    line-height: 1;
    color: var(--deep-teal);
  }
  .stats span {
    font-size: 14px;
    color: var(--muted);
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  @media (min-width: 900px) {
    h2 {
      font-size: 48px;
    }
    .stats {
      grid-template-columns: 1fr 1.4fr;
      align-items: center;
    }
  }
</style>
