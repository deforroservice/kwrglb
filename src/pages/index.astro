---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.tsx';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import { projects, posts, pillars } from '../data/site';
import { url } from '../lib/url';

const featured = projects.slice(0, 3);
const latest = posts.slice(0, 3);
---

<Base>
  <Hero
    dark
    eyebrow="Research · Partnerships · Funding · Impact"
    title="From strong ideas to international projects."
    subtitle="KWARG helps universities, research organisations and mission-driven institutions build international partnerships and secure competitive funding for research, innovation and development projects."
  >
    <p class="hero-more">
      We connect scientific expertise, funding opportunities and complementary partners, supporting the journey from
      initial project concept to coordinated proposal submission.
    </p>
    <div class="ctas">
      <a class="btn btn-primary" href={url('about/')}>Explore our approach <span class="arrow">→</span></a>
      <a class="btn btn-secondary btn-on-dark" href={url('projects/')}>Our projects <span class="arrow">→</span></a>
    </div>
  </Hero>

  <section class="container block">
    <div class="head">
      <div>
        <p class="label">Projects</p>
        <h2>Research built through collaboration.</h2>
        <p class="intro">
          Explore our work across applied research, environmental intelligence and international scientific partnerships.
        </p>
      </div>
      <a class="btn btn-tertiary" href={url('projects/')}>View projects <span class="arrow">→</span></a>
    </div>
    <ul class="pcard-grid">
      {featured.map((p) => <li><ProjectCard project={p} /></li>)}
    </ul>
  </section>

  <section class="band">
    <div class="container">
      <div class="head">
        <div>
          <p class="label">What we do</p>
          <h2>Connecting research, funding and international collaboration.</h2>
          <p class="intro">
            KWARG works at the intersection of scientific research, technology and international development. We help
            organisations translate their expertise and ambitions into credible collaborative projects, combining
            technical understanding with structured project development and practical coordination.
          </p>
        </div>
        <a class="btn btn-tertiary" href={url('about/')}>About us <span class="arrow">→</span></a>
      </div>
      <ul class="pillars">
        {
          pillars.map((p) => (
            <li>
              <Icon name={p.icon} />
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="container block">
    <div class="head">
      <div>
        <p class="label">Insights</p>
        <h2>Insights &amp; perspectives.</h2>
        <p class="intro">
          Perspectives on international research collaboration, competitive funding, emerging technologies and the
          practical development of multidisciplinary projects.
        </p>
      </div>
      <a class="btn btn-tertiary" href={url('insights/')}>All insights <span class="arrow">→</span></a>
    </div>
    <ul class="posts">
      {latest.map((p) => <li><PostCard post={p} /></li>)}
    </ul>
  </section>
</Base>

<style>
  .hero-more {
    display: none;
    margin: -8px 0 22px;
    max-width: 60ch;
    color: rgba(255, 255, 255, 0.75);
  }
  @media (min-width: 600px) {
    .hero-more {
      display: block;
    }
  }
  .intro {
    margin: 12px 0 0;
    max-width: 64ch;
    color: var(--muted);
  }
  .head > div {
    max-width: 820px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .block {
    padding-top: 40px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px 24px;
    margin-bottom: 20px;
  }
  .head .label {
    margin: 0 0 6px;
  }
  h2 {
    margin: 0;
    font-size: 40px;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }
  .band {
    margin-top: 72px;
    padding: 56px 0 64px;
    background: var(--band);
  }
  .pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 28px 32px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .pillars li {
    border-top: 2px solid var(--green);
    padding-top: 20px;
    color: var(--deep-teal);
  }
  .pillars h3 {
    margin: 14px 0 6px;
    font-size: 26px;
    font-weight: 600;
    line-height: 1.05;
  }
  .pillars p {
    margin: 0;
    font-size: 15px;
    line-height: 24px;
    color: var(--muted);
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  @media (min-width: 900px) {
    h2 {
      font-size: 48px;
    }
  }
</style>
