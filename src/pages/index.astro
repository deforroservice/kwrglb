---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.tsx';
import PostCard from '../components/PostCard.astro';
import PubCard from '../components/PubCard.astro';
import Scroller from '../components/Scroller.astro';
import Icon from '../components/Icon.astro';
import { projects, posts, publications, pillars, partners, partnersIntro } from '../data/site';
import { url } from '../lib/url';
import { wavesUrl } from '../lib/art';

// Insights and publications together, newest first (publications only have a year).
const insights = [
  ...posts.map((post) => ({ sort: post.date, post })),
  ...publications.map((pub) => ({ sort: `${pub.year}-00-00`, pub })),
].sort((a, b) => b.sort.localeCompare(a.sort));
---

<Base>
  <Hero
    dark
    eyebrow="Innovation & project development services"
    title="From strong ideas to international projects"
    subtitle="We turn research and innovation ideas into international projects ready for public funding and private investment, for research organisations, universities, R&D teams, companies and NGOs."
  >
    <div class="ctas">
      <a class="btn btn-primary" href={url('about/')}>Explore our approach <span class="arrow">→</span></a>
      <a class="btn btn-secondary btn-on-dark" href={url('projects/')}>Our projects <span class="arrow">→</span></a>
    </div>
  </Hero>

  <section class="container block">
    <div class="head">
      <div>
        <p class="label">Projects</p>
        <h2>Research, innovation &amp; impact built through collaboration</h2>
        <p class="intro">
          Explore our work across applied research, environmental intelligence and international scientific partnerships.
        </p>
      </div>
      <a class="btn btn-tertiary" href={url('projects/')}>View projects <span class="arrow">→</span></a>
    </div>
    <Scroller label="Projects">
      <ul class="pcard-grid">
        {projects.map((p) => <li><ProjectCard project={p} /></li>)}
      </ul>
    </Scroller>
  </section>

  <section class="band dark">
    <div class="container">
      <div class="head">
        <div>
          <p class="label">What we do</p>
          <h2>Connecting research, funding and international collaboration</h2>
          <p class="intro">
            KWARG works at the intersection of scientific research, technology and international development. We help
            organisations translate their expertise and ambitions into credible collaborative projects, combining
            technical understanding with structured project development and practical coordination.
          </p>
        </div>
        <a class="btn btn-tertiary" href={url('about/')}>About us <span class="arrow">→</span></a>
      </div>
      <ul class="pillars">
        {
          pillars.map((p, i) => (
            <li>
              <span
                class="tile-art"
                aria-hidden="true"
                style={`background-image:${wavesUrl(5 + i * 7, { stroke: '#6ED3A4', opacity: 0.45, lines: 18, width: 600, height: 400, fade: true })}`}
              />
              <span class="ic"><Icon name={p.icon} size={26} /></span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="container block">
    <div class="head">
      <div>
        <p class="label">Insights</p>
        <h2>Insights &amp; publications</h2>
        <p class="intro">
          Perspectives, news and publications on international research collaboration, competitive funding and the
          practical development of multidisciplinary projects.
        </p>
      </div>
      <a class="btn btn-tertiary" href={url('insights/')}>All insights <span class="arrow">→</span></a>
    </div>
    <Scroller label="Insights">
      <ul class="posts">
        {insights.map((it) => <li>{it.post ? <PostCard post={it.post} /> : <PubCard pub={it.pub!} />}</li>)}
      </ul>
    </Scroller>
  </section>

  <section id="partners" class="container block partners">
    <div class="head">
      <div>
        <p class="label">Partners</p>
        <h2>Our partners &amp; collaborations</h2>
        <p class="intro">{partnersIntro}</p>
      </div>
      <div class="hnav" aria-label="Scroll partners">
        <button class="harrow prev" type="button" aria-label="Previous partners">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
        </button>
        <button class="harrow next" type="button" aria-label="Next partners">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
        </button>
      </div>
    </div>
    <ul class="logos" tabindex="0" aria-label="Partners and collaborations">
      {
        partners.map((p) => (
          <li>
            <span class="logo-box"><img src={url(p.logo)} alt="" loading="lazy" /></span>
            <span class="pname">{p.name}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  // Partners row: left/right arrows scroll by roughly one screen of logos.
  const row = document.querySelector<HTMLElement>('#partners .logos')!;
  const prev = document.querySelector<HTMLButtonElement>('#partners .prev')!;
  const next = document.querySelector<HTMLButtonElement>('#partners .next')!;
  const step = () => Math.max(row.clientWidth * 0.8, 200);
  const sync = () => {
    const max = row.scrollWidth - row.clientWidth;
    prev.disabled = row.scrollLeft <= 2;
    next.disabled = row.scrollLeft >= max - 2;
    document.querySelector('#partners .hnav')!.toggleAttribute('hidden', max <= 2);
  };
  prev.addEventListener('click', () => row.scrollBy({ left: -step() }));
  next.addEventListener('click', () => row.scrollBy({ left: step() }));
  row.addEventListener('scroll', sync, { passive: true });
  new ResizeObserver(sync).observe(row);
</script>


<style>
  .intro {
    margin: 12px 0 0;
    max-width: 64ch;
    color: var(--muted);
  }
  .head > div {
    max-width: 820px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .block {
    padding-top: 40px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px 24px;
    margin-bottom: 20px;
  }
  .head .label {
    margin: 0 0 6px;
  }
  h2 {
    margin: 0;
    font-size: 40px;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }
  .band {
    margin-top: 72px;
    padding: 56px 0 64px;
    background: var(--band);
  }
  /* What we do: dark band with tiles that light up on hover (visual only) */
  .band.dark {
    background: var(--deep-teal);
  }
  .dark .label {
    color: var(--green);
  }
  .dark h2 {
    color: #fff;
  }
  .dark .intro {
    color: rgba(255, 255, 255, 0.78);
  }
  .dark .btn-tertiary {
    color: #fff;
  }
  .pillars {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .pillars li {
    position: relative;
    overflow: hidden;
    padding: 28px 24px 26px;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #fff;
    transition: background 0.35s, border-color 0.35s, transform 0.35s;
  }
  .pillars li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    height: 3px;
    width: 48px;
    background: var(--green);
    transition: width 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tile-art {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: right bottom;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.45s, transform 0.45s;
    pointer-events: none;
  }
  .pillars li > :not(.tile-art) {
    position: relative;
  }
  .ic {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1.5px solid rgba(110, 211, 164, 0.6);
    color: var(--green);
    transition: background 0.35s, color 0.35s, transform 0.35s;
  }
  .pillars h3 {
    margin: 18px 0 8px;
    font-size: 26px;
    font-weight: 600;
    line-height: 1.05;
    color: #fff;
  }
  .pillars p {
    margin: 0;
    font-size: 15px;
    line-height: 24px;
    color: rgba(255, 255, 255, 0.78);
  }
  .pillars li:hover {
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(110, 211, 164, 0.5);
    transform: translateY(-4px);
  }
  .pillars li:hover::before {
    width: 100%;
  }
  .pillars li:hover .tile-art {
    opacity: 1;
    transform: none;
  }
  .pillars li:hover .ic {
    background: var(--green);
    color: var(--deep-teal);
    transform: rotate(-8deg) scale(1.05);
  }
  @media (prefers-reduced-motion: reduce) {
    .pillars li,
    .pillars li::before,
    .tile-art,
    .ic {
      transition: none;
    }
    .pillars li:hover {
      transform: none;
    }
  }
  .partners {
    padding-top: 64px;
    scroll-margin-top: 72px;
  }
  .hnav {
    display: flex;
    gap: 8px;
  }
  .harrow {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1.5px solid var(--deep-teal);
    background: var(--surface);
    color: var(--deep-teal);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, opacity 0.15s;
  }
  .harrow:hover:not(:disabled) {
    background: var(--deep-teal);
    color: #fff;
  }
  .harrow:focus-visible,
  .logos:focus-visible {
    outline: 3px solid var(--green);
    outline-offset: 3px;
  }
  .harrow:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .logos {
    list-style: none;
    margin: 8px 0 0;
    padding: 4px 2px 12px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 200px;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: var(--green) transparent;
  }
  .logos li {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 22px 16px 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-align: center;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .logos li:hover {
    border-color: var(--green);
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(30, 74, 95, 0.1);
  }
  .logo-box {
    display: grid;
    place-items: center;
    width: 100%;
    height: 96px;
  }
  .logo-box img {
    max-width: 100%;
    max-height: 96px;
    object-fit: contain;
    border-radius: 8px;
  }
  .pname {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
    color: var(--deep-teal);
    text-wrap: balance;
  }
  @media (max-width: 600px) {
    .logos {
      grid-auto-columns: 160px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .logos {
      scroll-behavior: auto;
    }
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 600px) {
    .posts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .posts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    h2 {
      font-size: 48px;
    }
  }
</style>
