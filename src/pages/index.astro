---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.tsx';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import { projects, posts, pillars } from '../data/site';
import { url } from '../lib/url';

const featured = projects.slice(0, 3);
const latest = posts.slice(0, 3);
---

<Base>
  <Hero
    dark
    eyebrow="Research · Partnerships · Funding · Impact"
    title="Bold research for a brighter tomorrow"
    subtitle="Placeholder: we help turn research and innovation into funded, real-world solutions for people and the planet."
  >
    <div class="ctas">
      <a class="btn btn-primary" href={url('about/')}>Explore our approach <span class="arrow">→</span></a>
      <a class="btn btn-secondary btn-on-dark" href={url('projects/')}>Our projects</a>
    </div>
  </Hero>

  <section class="container block">
    <div class="head">
      <div>
        <p class="label">Projects</p>
        <h2>Research builds tomorrow</h2>
      </div>
      <a class="btn btn-tertiary" href={url('projects/')}>View projects <span class="arrow">→</span></a>
    </div>
    <ul class="pcard-grid">
      {featured.map((p) => <li><ProjectCard project={p} /></li>)}
    </ul>
  </section>

  <section class="band">
    <div class="container">
      <div class="head">
        <div>
          <p class="label">What we do</p>
          <h2>Turning knowledge into real-world impact</h2>
        </div>
        <a class="btn btn-tertiary" href={url('about/')}>About us <span class="arrow">→</span></a>
      </div>
      <ul class="pillars">
        {
          pillars.map((p) => (
            <li>
              <Icon name={p.icon} />
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="container block">
    <div class="head">
      <div>
        <p class="label">Insights</p>
        <h2>Insights &amp; news</h2>
      </div>
      <a class="btn btn-tertiary" href={url('insights/')}>All insights <span class="arrow">→</span></a>
    </div>
    <ul class="posts">
      {latest.map((p) => <li><PostCard post={p} /></li>)}
    </ul>
  </section>
</Base>

<style>
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .block {
    padding-top: 40px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px 24px;
    margin-bottom: 20px;
  }
  .head .label {
    margin: 0 0 6px;
  }
  h2 {
    margin: 0;
    font-size: 40px;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }
  .band {
    margin-top: 72px;
    padding: 56px 0 64px;
    background: var(--band);
  }
  .pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 28px 32px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .pillars li {
    border-top: 2px solid var(--green);
    padding-top: 20px;
    color: var(--deep-teal);
  }
  .pillars h3 {
    margin: 14px 0 6px;
    font-size: 26px;
    font-weight: 600;
    line-height: 1.05;
  }
  .pillars p {
    margin: 0;
    font-size: 15px;
    line-height: 24px;
    color: var(--muted);
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  @media (min-width: 900px) {
    h2 {
      font-size: 48px;
    }
  }
</style>
