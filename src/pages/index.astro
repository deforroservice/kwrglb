---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { projects, posts, coverStyle } from '../data/site';
import { url } from '../lib/url';

const featured = projects.filter((p) => p.status === 'Current').slice(0, 3);
const latest = posts.slice(0, 2);
---

<Base>
  <Hero
    title="Placeholder headline about what this lab is for."
    subtitle="Placeholder subtitle. One or two sentences that explain the mission in plain words."
  >
    <a class="pill cta" href={url('projects/')}>See our projects</a>
  </Hero>

  <section class="container block">
    <div class="head">
      <h2>Current projects</h2>
      <a href={url('projects/')}>All projects</a>
    </div>
    <ul class="cards">
      {
        featured.map((p) => (
          <li>
            <a class="card" href={url(`projects/${p.slug}/`)} style={`background-image:${coverStyle(p.palette)}`}>
              <span>{p.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="band">
    <div class="grid12">
      <div class="span-8">
        <h2>How we work</h2>
        <p><strong>Explore.</strong> Placeholder text about finding a problem worth solving.</p>
        <p><strong>Build.</strong> Placeholder text about testing the idea quickly.</p>
        <p><strong>Graduate.</strong> Placeholder text about what happens when it works.</p>
        <a class="pill" href={url('lab/')}>More about the lab</a>
      </div>
    </div>
  </section>

  <section class="container block">
    <div class="head">
      <h2>From the blog</h2>
      <a href={url('blog/')}>All posts</a>
    </div>
    <ul class="posts">
      {
        latest.map((p) => (
          <li>
            <time datetime={p.date}>{p.date}</time>
            <h3><a href={url(`blog/${p.slug}/`)}>{p.title}</a></h3>
            <p>{p.excerpt}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .cta {
    margin-top: 32px;
  }
  .block {
    padding-top: 48px;
    padding-bottom: 48px;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 24px;
  }
  h2 {
    margin: 0 0 16px;
    font-size: 28px;
    font-weight: 500;
    line-height: 36px;
    letter-spacing: -0.5px;
  }
  .head h2 {
    margin: 0;
  }
  .head a {
    font-size: 14px;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 900px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }
  .card {
    position: relative;
    display: block;
    aspect-ratio: 345 / 439;
    border-radius: var(--radius);
    overflow: hidden;
    background-size: cover;
    text-decoration: none;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0) 35%);
  }
  .card span {
    position: absolute;
    top: 20px;
    left: 20px;
    right: 20px;
    color: #fafafa;
    font-size: 20px;
    line-height: 22px;
  }
  .band {
    background: var(--band);
    padding: 64px 0;
  }
  .band p {
    margin: 0 0 12px;
  }
  .band .pill {
    margin-top: 16px;
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .posts li {
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  time {
    font-size: 13px;
    color: var(--muted);
  }
  h3 {
    margin: 2px 0;
    font-size: 20px;
    font-weight: 500;
  }
  h3 a {
    text-decoration: none;
  }
  .posts p {
    margin: 0;
    color: var(--muted);
  }
</style>
