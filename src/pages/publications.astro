---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import { publications, contributions } from '../data/site';
---

<Base title="Publications & key contributions" description="Placeholder description of publications and contributions.">
  <Hero
    eyebrow="Publications"
    title="Publications & key contributions"
    subtitle="Placeholder: peer-reviewed work, reports and datasets, plus the projects and proposals we helped make happen."
  />

  <section class="container">
    <h2>Publications</h2>
    <ul class="pubs">
      {
        publications.map((p) => (
          <li>
            <span class="year">{p.year}</span>
            <div class="info">
              <span class="chip">{p.type}</span>
              <h3>{p.href ? <a href={p.href}>{p.title}</a> : p.title}</h3>
              <p>
                {p.authors} · <em>{p.venue}</em>
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="band">
    <div class="container">
      <h2>Key contributions</h2>
      <ul class="contrib">
        {
          contributions.map((c) => (
            <li>
              <Icon name="document" size={32} />
              <h3>{c.title}</h3>
              <p>{c.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  h2 {
    margin: 0 0 20px;
    font-size: 36px;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }
  .pubs {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .pubs li {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 16px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }
  .year {
    font-family: var(--display);
    font-size: 24px;
    font-weight: 600;
    color: var(--slate-teal);
  }
  .info .chip::before {
    display: none;
  }
  .pubs h3 {
    margin: 8px 0 4px;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.1;
  }
  .pubs h3 a {
    text-decoration: none;
  }
  .pubs p {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }
  .band {
    margin-top: 72px;
    padding: 56px 0 64px;
    background: var(--band);
  }
  .contrib {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 28px 32px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .contrib li {
    border-top: 2px solid var(--green);
    padding-top: 18px;
    color: var(--deep-teal);
  }
  .contrib h3 {
    margin: 12px 0 6px;
    font-size: 24px;
    font-weight: 600;
  }
  .contrib p {
    margin: 0;
    font-size: 15px;
    line-height: 24px;
    color: var(--muted);
  }
</style>
