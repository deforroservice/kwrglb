---
import Base from '../../layouts/Base.astro';
import { projects, site, type Project } from '../../data/site';
import { darkCover } from '../../lib/art';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
---

<Base title={project.name} description={project.summary}>
  <!-- Short dark header: title, summary and buttons on the left, key facts on the right -->
  <section class="head" style={`background:${darkCover(project.seed)}`}>
    <div class="container grid">
      <div>
        <span class="chip" data-cat={project.category}>{project.category}</span>
        <h1>{project.name}</h1>
        <p class="summary">{project.summary}</p>
        <div class="ctas">
          <a class="btn btn-primary" href={`mailto:${site.email}?subject=${encodeURIComponent(project.name)}`}>
            Contact the team <span class="arrow">→</span>
          </a>
          <a class="btn btn-secondary btn-on-dark" href={url('projects/')}>All projects</a>
        </div>
      </div>
      {
        project.facts.length > 0 && (
          <dl class="facts">
            {project.facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </section>

  <article class="body grid12">
    <div class="span-7">
      <p class="lead">{project.intro}</p>
      {
        project.sections.map((s) => (
          <section>
            <h2>{s.heading}</h2>
            {s.paragraphs?.map((p) => <p>{p}</p>)}
            {s.bullets && (
              <ul class="bullets">
                {s.bullets.map((b) => (
                  <li>
                    {b.title && <strong>{b.title}</strong>}
                    <span>{b.text}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
      {
        project.references && (
          <section class="refs">
            <h2>Publications &amp; news</h2>
            <ul>
              {project.references.map((r) => {
                const external = r.href.startsWith('http');
                return (
                  <li>
                    <a href={external ? r.href : url(r.href)} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
                      <span class="kind">{r.kind}</span>
                      <span class="rtitle">{r.title}</span>
                      <span class="src">{r.source}</span>
                      <span class="go" aria-hidden="true">{external ? '↗' : '→'}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }
    </div>
  </article>
</Base>

<style>
  .head {
    padding: 40px 0 44px;
    color: #fff;
  }
  .grid {
    display: grid;
    gap: 28px;
  }
  .chip {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }
  .chip::before {
    background: var(--green);
  }
  h1 {
    margin: 14px 0 0;
    font-size: 40px;
    font-weight: 700;
    line-height: 0.98;
    text-transform: uppercase;
    text-wrap: balance;
    color: #fff;
  }
  .summary {
    margin: 14px 0 0;
    max-width: 60ch;
    font-size: 18px;
    font-weight: 500;
    line-height: 28px;
    color: var(--green);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
  .facts {
    display: grid;
    gap: 12px;
    margin: 0;
    padding-left: 24px;
    border-left: 2px solid rgba(110, 211, 164, 0.5);
  }
  .facts div {
    display: grid;
    gap: 1px;
  }
  .facts dt {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
  }
  .facts dd {
    margin: 0;
    font-size: 14px;
    line-height: 22px;
    color: #fff;
  }
  .body {
    padding-top: 44px;
  }
  .lead {
    margin: 0 0 8px;
    font-size: 18px;
    line-height: 30px;
    color: var(--deep-teal);
  }
  h2 {
    margin: 36px 0 12px;
    font-size: 30px;
    font-weight: 600;
    line-height: 1.05;
    text-transform: uppercase;
  }
  .body p {
    margin: 0 0 16px;
  }
  .bullets {
    list-style: none;
    margin: 8px 0 16px;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .bullets li {
    display: grid;
    gap: 2px;
    padding-left: 18px;
    border-left: 3px solid var(--green);
  }
  .bullets strong {
    color: var(--deep-teal);
  }
  .bullets span {
    color: var(--muted);
  }
  .refs ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .refs a {
    position: relative;
    display: grid;
    gap: 4px;
    padding: 16px 48px 16px 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 3px solid var(--green);
    border-radius: var(--radius);
    text-decoration: none;
    transition: box-shadow 0.2s, border-color 0.2s;
  }
  .refs a:hover {
    border-color: var(--green);
    box-shadow: 0 10px 24px rgba(30, 74, 95, 0.1);
  }
  .kind {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green-dark);
  }
  .rtitle {
    font-family: var(--display);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.1;
    color: var(--deep-teal);
  }
  .src {
    font-size: 14px;
    color: var(--muted);
  }
  .go {
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 18px;
    color: var(--deep-teal);
  }
  @media (min-width: 900px) {
    .head {
      padding: 56px 0 56px;
    }
    .grid {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: 56px;
      align-items: end;
    }
    h1 {
      font-size: 56px;
    }
    .body {
      padding-top: 56px;
    }
  }
</style>
