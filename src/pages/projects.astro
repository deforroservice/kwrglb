---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectsList from '../components/ProjectsList.tsx';
import { projects } from '../data/site';
---

<Base title="Projects" description="KWARG projects in environmental intelligence, climate technology, air quality monitoring and technology partnerships.">
  <Hero
    eyebrow="Projects"
    title="Projects"
    subtitle="From scientific R&D to funded international consortia: our work in environmental intelligence, climate technology, air quality monitoring and technology partnerships for social impact."
  />
  <section class="container">
    <ProjectsList client:visible projects={projects} />
  </section>
</Base>
