---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { partners } from '../data/site';
import { url } from '../lib/url';

// Placeholder "logo": initials of the partner name, until real logos are added.
const initials = (name: string) =>
  name
    .split(' ')
    .map((w) => w[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<Base title="Partners" description="Placeholder description of partners.">
  <Hero
    eyebrow="Partners"
    title="Partners"
    subtitle="Placeholder: the universities, institutes, funders and organisations we work with."
  />
  <section class="container">
    <ul class="grid">
      {
        partners.map((p) => (
          <li>
            <span class="logo" aria-hidden="true">{initials(p.name)}</span>
            <span class="type">{p.type}</span>
            <h2>{p.name}</h2>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ul>
    <p class="cta">
      <a class="btn btn-primary" href={url('contact/')}>Become a partner <span class="arrow">→</span></a>
    </p>
  </section>
</Base>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .logo {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 10px;
    border-radius: 50%;
    border: 1.5px solid var(--green);
    font-family: var(--display);
    font-size: 20px;
    font-weight: 600;
    color: var(--deep-teal);
  }
  .type {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--slate-teal);
  }
  h2 {
    margin: 0;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.1;
  }
  p {
    margin: 0;
    font-size: 14px;
    line-height: 22px;
    color: var(--muted);
  }
  .cta {
    margin-top: 32px;
  }
</style>
