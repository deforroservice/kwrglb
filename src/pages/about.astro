---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Prose from '../components/Prose.astro';
import { pillars, team } from '../data/site';
import { url } from '../lib/url';
---

<Base title="About us" description="KWARG connects scientific expertise, funding opportunities and complementary partners to build international research and innovation projects.">
  <Hero
    eyebrow="About us"
    title="About us"
    subtitle="We help universities, research organisations and mission-driven institutions build international partnerships and secure competitive funding for research, innovation and development projects."
  />
  <Prose>
    <p>
      KWARG works at the intersection of scientific research, technology and international development. We help
      organisations translate their expertise and ambitions into credible collaborative projects, combining technical
      understanding with structured project development and practical coordination.
    </p>

    <h2>What we do</h2>
    {pillars.map((p) => <p><strong>{p.title}.</strong> {p.text}</p>)}

    <h2>Our approach</h2>
    <p>
      We support the full journey from initial project concept to coordinated proposal submission: finding the right
      opportunity, shaping the scientific and technical case, bringing complementary partners together, and coordinating
      their contributions into one coherent proposal.
    </p>

    <h2>Our team</h2>
    <ul class="team">
      {
        team.map((m) => (
          <li>
            {m.photo ? (
              <img class="avatar" src={url(m.photo)} alt={`Portrait of ${m.name}`} width="128" height="128" />
            ) : (
              <span class="avatar placeholder" aria-hidden="true">
                <svg viewBox="0 0 48 48" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.6">
                  <circle cx="24" cy="18" r="8" />
                  <path d="M9 41c1.5-8 7.5-12 15-12s13.5 4 15 12" />
                </svg>
              </span>
            )}
            <strong>{m.name}</strong>
            <span>{m.role}</span>
          </li>
        ))
      }
    </ul>

    <p class="ctas">
      <a class="btn btn-primary" href={url('contact/')}>Get in touch <span class="arrow">→</span></a>
      <a class="btn btn-secondary" href={url('careers/')}>Careers</a>
    </p>
  </Prose>
</Base>

<style>
  .team {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  }
  .team li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
  }
  .avatar {
    width: 128px;
    height: 128px;
    margin-bottom: 10px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--surface);
    box-shadow: 0 0 0 2px var(--green);
  }
  .avatar.placeholder {
    display: grid;
    place-items: center;
    background: var(--band);
    border: 2px solid var(--green);
    color: var(--slate-teal);
  }
  .team strong {
    font-family: var(--display);
    font-size: 20px;
    font-weight: 600;
    color: var(--deep-teal);
  }
  .team span {
    font-size: 14px;
    color: var(--muted);
  }
  p.ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
</style>
