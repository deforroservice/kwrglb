---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import PostCard from '../../components/PostCard.astro';
import { posts } from '../../data/site';
---

<Base title="Insights & perspectives" description="Perspectives on international research collaboration, competitive funding, emerging technologies and multidisciplinary project development.">
  <Hero
    eyebrow="Insights & News"
    title="Insights & perspectives"
    subtitle="Perspectives on international research collaboration, competitive funding, emerging technologies and the practical development of multidisciplinary projects."
  />
  <section class="container">
    <ul class="posts">
      {posts.map((p) => <li><PostCard post={p} /></li>)}
    </ul>
  </section>
</Base>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
</style>
