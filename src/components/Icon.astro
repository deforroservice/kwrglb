---
// Thin line icons in the brand style.
interface Props {
  name: 'research' | 'funding' | 'partners' | 'document' | 'global';
  size?: number;
}
const { name, size = 36 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'research' && (
    <>
      <circle cx="15" cy="15" r="9" />
      <path d="M22 22l8 8M11 15a4 4 0 0 1 4-4" />
    </>
  )}
  {name === 'funding' && (
    <>
      <ellipse cx="18" cy="9" rx="10" ry="4" />
      <path d="M8 9v6c0 2.2 4.5 4 10 4s10-1.8 10-4V9M8 15v6c0 2.2 4.5 4 10 4s10-1.8 10-4v-6M8 21v6c0 2.2 4.5 4 10 4s10-1.8 10-4v-6" />
    </>
  )}
  {name === 'partners' && (
    <>
      <circle cx="12" cy="12" r="4.5" />
      <circle cx="25" cy="13" r="3.5" />
      <path d="M4 29c0-5 3.6-8.5 8-8.5s8 3.5 8 8.5M20 21.5c1.4-1 3-1.5 5-1.5 4 0 7 3 7 7.5" />
    </>
  )}
  {name === 'document' && (
    <>
      <rect x="8" y="4" width="20" height="28" rx="2" />
      <path d="M13 12h10M13 17h10M13 22h6" />
    </>
  )}
  {name === 'global' && (
    <>
      <circle cx="18" cy="18" r="13" />
      <path d="M5 18h26M18 5c4 4 4 22 0 26M18 5c-4 4-4 22 0 26" />
    </>
  )}
</svg>
