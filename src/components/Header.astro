---
import Search from './Search.tsx';
import { nav, socials, site, projects, posts } from '../data/site';
import { url } from '../lib/url';

const searchItems = [
  ...nav.map((n) => ({ title: n.label, kind: 'Page', href: url(n.href), text: '' })),
  ...projects.map((p) => ({ title: p.name, kind: 'Project', href: url(`projects/${p.slug}/`), text: p.tagline })),
  ...posts.map((p) => ({ title: p.title, kind: 'Post', href: url(`blog/${p.slug}/`), text: p.excerpt })),
];
---

<header class="header">
  <div class="bar">
    <a class="logo" href={url()} aria-label={`${site.name} home`}>
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
        <rect x="2" y="2" width="18" height="18" rx="3" fill="none" stroke="currentColor" stroke-width="2.2" />
        <path d="M8 6v10M8 11l6-5M10 9.5l4.5 6.5" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
    <nav class="inline-nav" aria-label="Main">
      {nav.map((n) => <a href={url(n.href)}>{n.label}</a>)}
    </nav>
    <div class="actions">
      <Search client:idle items={searchItems} />
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<nav id="site-menu" class="menu" hidden aria-label="Menu">
  <ul class="pages">
    <li><a href={url()}>Home</a></li>
    {nav.map((n) => <li><a href={url(n.href)}>{n.label}</a></li>)}
  </ul>
  <ul class="small">
    {socials.map((s) => <li><a href={s.href} rel="noopener" target="_blank">{s.label}</a></li>)}
  </ul>
</nav>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
  const menu = document.getElementById('site-menu')!;
  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };
  btn.addEventListener('click', () => setOpen(menu.hidden));
  window.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  matchMedia('(min-width: 900px)').addEventListener('change', () => setOpen(false));
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: #000;
    color: #fff;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 56px;
    padding: 0 20px;
  }
  .logo {
    display: grid;
    place-items: center;
    color: #fff;
  }
  .inline-nav {
    display: none;
    margin-left: auto;
    gap: 28px;
  }
  .inline-nav a {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .inline-nav a:hover {
    opacity: 0.7;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }
  .actions :global(.search-trigger) {
    color: #fff;
  }
  .actions :global(.search-trigger:hover) {
    background: rgba(255, 255, 255, 0.15);
  }
  .menu-btn {
    width: 40px;
    height: 40px;
    border: 0;
    background: transparent;
    cursor: pointer;
    display: grid;
    place-content: center;
    gap: 6px;
  }
  .menu-btn span {
    display: block;
    width: 20px;
    height: 2px;
    background: #fff;
    transition: transform 0.2s;
  }
  .menu-btn[aria-expanded='true'] span:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }
  @media (min-width: 900px) {
    .bar {
      height: 52px;
      padding: 0 24px;
    }
    .inline-nav {
      display: flex;
    }
    .actions {
      margin-left: 8px;
    }
    .menu-btn {
      display: none;
    }
  }

  .menu {
    position: fixed;
    inset: 56px 0 0;
    z-index: 39;
    background: #000;
    color: #fff;
    overflow-y: auto;
    padding: 24px 0;
  }
  .pages,
  .small {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pages a {
    display: block;
    padding: 8px 30px;
    font-size: 18px;
    font-weight: 500;
    line-height: 30px;
    text-decoration: none;
  }
  .small {
    display: flex;
    gap: 20px;
    padding: 24px 30px 0;
    font-size: 14px;
    opacity: 0.7;
  }
</style>
