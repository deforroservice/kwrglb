---
import Search from './Search.tsx';
import Logo from './Logo.astro';
import { nav, socials, site, projects, posts } from '../data/site';
import { url } from '../lib/url';

const searchItems = [
  ...nav.map((n) => ({ title: n.label, kind: 'Page', href: url(n.href), text: '' })),
  ...projects.map((p) => ({ title: p.name, kind: 'Project', href: url(`projects/${p.slug}/`), text: p.summary + ' ' + p.category })),
  ...posts.map((p) => ({ title: p.title, kind: 'Insight', href: url(`insights/${p.slug}/`), text: p.excerpt })),
];
---

<header class="header">
  <div class="bar container">
    <a class="brand" href={url()} aria-label={`${site.name} home`}>
      <Logo size={26} />
      <span>{site.name}</span>
    </a>
    <nav class="inline-nav" aria-label="Main">
      {nav.map((n) => <a href={url(n.href)}>{n.label}</a>)}
    </nav>
    <div class="actions">
      <Search client:idle items={searchItems} />
      <a class="btn btn-primary cta" href={url('contact/')}>Get in touch</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<nav id="site-menu" class="menu" hidden aria-label="Menu">
  <ul class="pages">
    <li><a href={url()}>Home</a></li>
    {nav.map((n) => <li><a href={url(n.href)}>{n.label}</a></li>)}
    <li><a href={url('contact/')}>Get in touch</a></li>
  </ul>
  <ul class="small">
    {socials.map((s) => <li><a href={s.href} rel="noopener" target="_blank">{s.label}</a></li>)}
  </ul>
</nav>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
  const menu = document.getElementById('site-menu')!;
  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };
  btn.addEventListener('click', () => setOpen(menu.hidden));
  window.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  matchMedia('(min-width: 1100px)').addEventListener('change', () => setOpen(false));
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: #fff;
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 64px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: var(--display);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--deep-teal);
    white-space: nowrap;
  }
  .inline-nav {
    display: none;
    margin-left: auto;
    gap: 32px;
  }
  .inline-nav a {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--deep-teal);
  }
  .inline-nav a:hover {
    color: var(--green-dark);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }
  .actions :global(.search-trigger) {
    color: var(--deep-teal);
  }
  .cta {
    display: none;
  }
  .menu-btn {
    width: 40px;
    height: 40px;
    border: 0;
    background: transparent;
    cursor: pointer;
    display: grid;
    place-content: center;
    gap: 6px;
  }
  .menu-btn span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--deep-teal);
    transition: transform 0.2s;
  }
  .menu-btn[aria-expanded='true'] span:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }
  @media (min-width: 1100px) {
    .inline-nav {
      display: flex;
    }
    .actions {
      margin-left: 0;
    }
    .cta {
      display: inline-flex;
    }
    .menu-btn {
      display: none;
    }
  }

  .menu {
    position: fixed;
    inset: 65px 0 0;
    z-index: 39;
    background: var(--deep-teal);
    color: #fff;
    overflow-y: auto;
    padding: 24px 0;
  }
  .pages,
  .small {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pages a {
    display: block;
    padding: 8px var(--gutter);
    font-family: var(--display);
    font-size: 30px;
    font-weight: 600;
    line-height: 40px;
    text-transform: uppercase;
    text-decoration: none;
  }
  .pages a:hover {
    color: var(--green);
  }
  .small {
    display: flex;
    gap: 20px;
    padding: 24px var(--gutter) 0;
    font-size: 14px;
    opacity: 0.75;
  }
</style>
