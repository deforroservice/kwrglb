---
import type { Post } from '../data/site';
import { url } from '../lib/url';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const date = new Date(post.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<a class="post" href={url(`insights/${post.slug}/`)}>
  <span class="thumb"><img src={url(post.cover)} style={post.coverPosition ? `object-position:${post.coverPosition}` : undefined} alt="" loading="lazy" /></span>
  <span class="body">
    <span class="top">
      <span class="topic">{post.topic}</span>
      <time datetime={post.date}>{date}</time>
    </span>
    <span class="title">{post.title}</span>
    <span class="text">{post.excerpt}</span>
    <span class="more">{post.kind === 'News' ? 'Read news' : 'Read insight'} <span class="arrow">→</span></span>
  </span>
</a>

<style>
  .post {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition: box-shadow 0.2s;
  }
  .thumb {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--band);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .post:hover .thumb img {
    transform: scale(1.03);
  }
  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 20px 20px;
  }
  .post:hover {
    box-shadow: 0 12px 28px rgba(30, 74, 95, 0.12);
  }
  .top {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--mid-gray);
  }
  time {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .topic {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green-dark);
  }
  .title {
    font-family: var(--display);
    font-size: 26px;
    font-weight: 600;
    line-height: 1.05;
    color: var(--deep-teal);
  }
  .text {
    flex: 1;
    font-size: 14px;
    line-height: 22px;
    color: var(--muted);
  }
  .more {
    font-size: 14px;
    font-weight: 600;
    color: var(--green-dark);
  }
  .arrow {
    display: inline-block;
    transition: transform 0.15s;
  }
  .post:hover .arrow {
    transform: translateX(4px);
  }
</style>
