---
import type { Post } from '../data/site';
import { url } from '../lib/url';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const date = new Date(post.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<a class="post" href={url(`insights/${post.slug}/`)}>
  <span class="top">
    <svg width="34" height="42" viewBox="0 0 34 42" fill="none" aria-hidden="true">
      <rect x="1" y="1" width="32" height="40" rx="2" stroke="currentColor" stroke-width="1.5" />
      <path d="M8 12h18M8 18h18M8 24h18M8 30h10" stroke="currentColor" stroke-width="1.5" />
    </svg>
    <time datetime={post.date}>{date}</time>
  </span>
  <span class="topic">{post.topic}</span>
  <span class="title">{post.title}</span>
  <span class="text">{post.excerpt}</span>
  <span class="more">Read insight <span class="arrow">→</span></span>
</a>

<style>
  .post {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: 22px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition: box-shadow 0.2s;
  }
  .post:hover {
    box-shadow: 0 12px 28px rgba(30, 74, 95, 0.12);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    color: var(--mid-gray);
  }
  time {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .topic {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green-dark);
    margin-bottom: -6px;
  }
  .title {
    font-family: var(--display);
    font-size: 26px;
    font-weight: 600;
    line-height: 1.05;
    color: var(--deep-teal);
  }
  .text {
    flex: 1;
    font-size: 14px;
    line-height: 22px;
    color: var(--muted);
  }
  .more {
    font-size: 14px;
    font-weight: 600;
    color: var(--green-dark);
  }
  .arrow {
    display: inline-block;
    transition: transform 0.15s;
  }
  .post:hover .arrow {
    transform: translateX(4px);
  }
</style>
