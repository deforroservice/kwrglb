---
// Official KWARG LAB logo. variant 'full' = mark + wordmark, 'mark' = the two rings only.
import { LOGO_GREEN, markPath, wordPath } from '../lib/logo';

interface Props {
  variant?: 'full' | 'mark';
  height?: number;
  markColor?: string;
  wordColor?: string;
  class?: string;
}
const { variant = 'full', height = 32, markColor = LOGO_GREEN, wordColor = 'currentColor', class: cls } = Astro.props;
const viewBox = variant === 'full' ? '14 13 1742 358' : '4 4 540 376';
const [, , w, h] = viewBox.split(' ').map(Number);
---

<svg class={cls} height={height} width={(height * w) / h} viewBox={viewBox} aria-hidden="true">
  <path fill={markColor} fill-rule="evenodd" d={markPath} />
  {variant === 'full' && <path fill={wordColor} fill-rule="evenodd" d={wordPath} />}
</svg>
