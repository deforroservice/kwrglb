---
import { site, socials } from '../data/site';
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <ul>
      <li><a href={url('contact/')}>Contact</a></li>
      <li><a href={url('careers/')}>Careers</a></li>
      {socials.map((s) => <li><a href={s.href} rel="noopener" target="_blank">{s.label}</a></li>)}
    </ul>
    <p>© {year} {site.name}</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 120px;
    border-top: 1px solid var(--line);
    padding: 32px 0;
    font-size: 14px;
    color: var(--muted);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    justify-content: space-between;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }
  a {
    text-decoration: none;
  }
  a:hover {
    color: var(--text);
  }
  p {
    margin: 0;
  }
</style>
