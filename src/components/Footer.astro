---
import Logo from './Logo.astro';
import { site, socials, footerColumns } from '../data/site';
import { url } from '../lib/url';
import { darkCover } from '../lib/art';

const year = new Date().getFullYear();
---

<footer class="footer" style={`background:${darkCover(5)}`}>
  <div class="container top">
    <div class="about">
      <a class="brand" href={url()}>
        <Logo size={30} />
        <span>{site.name}</span>
      </a>
      <p>{site.tagline}</p>
    </div>
    {
      footerColumns.map((col) => (
        <div>
          <h2 class="col-title">{col.title}</h2>
          <ul>
            {col.links.map((l) => (
              <li>
                <a href={url(l.href)}>{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <div>
      <h2 class="col-title">Connect</h2>
      <ul>
        {socials.map((s) => <li><a href={s.href} rel="noopener" target="_blank">{s.label}</a></li>)}
        <li><a href={`mailto:${site.email}`}>Email</a></li>
      </ul>
    </div>
  </div>
  <div class="container bottom">
    <span>© {year} {site.name}. All rights reserved.</span>
    <span class="motto">{site.motto}</span>
  </div>
</footer>

<style>
  .footer {
    margin-top: 120px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 14px;
    line-height: 22px;
  }
  .top {
    display: grid;
    gap: 32px;
    grid-template-columns: repeat(2, 1fr);
    padding-top: 56px;
    padding-bottom: 40px;
  }
  .about {
    grid-column: 1 / -1;
  }
  @media (min-width: 900px) {
    .top {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
    .about {
      grid-column: auto;
    }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    font-family: var(--display);
    font-size: 28px;
    font-weight: 700;
    text-transform: uppercase;
    color: #fff;
  }
  .about p {
    max-width: 32ch;
    margin: 16px 0 0;
  }
  .col-title {
    margin: 0 0 12px;
    font-family: var(--font);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  a {
    text-decoration: none;
  }
  ul a:hover {
    color: var(--green);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    justify-content: space-between;
    padding-top: 20px;
    padding-bottom: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    font-size: 12px;
  }
  .motto {
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
</style>
