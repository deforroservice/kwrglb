---
import type { Publication } from '../data/site';
import Icon from './Icon.astro';
import { url } from '../lib/url';

interface Props {
  pub: Publication;
}
const { pub } = Astro.props;
const Tag = pub.href ? 'a' : 'div';
---

<Tag class="pub" href={pub.href} target={pub.href ? '_blank' : undefined} rel={pub.href ? 'noopener' : undefined}>
  <span class="thumb">
    {pub.cover ? <img src={url(pub.cover)} alt="" loading="lazy" /> : <span class="ph"><Icon name="document" size={40} /></span>}
  </span>
  <span class="body">
    <span class="top">
      <span class="topic">Publication · {pub.type}</span>
      <span class="year">{pub.year}</span>
    </span>
    <span class="title">{pub.title}</span>
    <span class="text">{pub.authors} · <em>{pub.venue}</em></span>
    {pub.href && <span class="more">View publication <span class="arrow">↗</span></span>}
  </span>
</Tag>

<style>
  .pub {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition: box-shadow 0.2s;
  }
  a.pub:hover {
    box-shadow: 0 12px 28px rgba(30, 74, 95, 0.12);
  }
  .thumb {
    display: block;
    aspect-ratio: 16 / 9;
    background: #ffffff;
    border-bottom: 3px solid var(--slate-teal);
    overflow: hidden;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    transition: transform 0.4s;
  }
  a.pub:hover .thumb img {
    transform: scale(1.03);
  }
  .ph {
    display: grid;
    place-items: center;
    height: 100%;
    background: var(--band);
    color: var(--slate-teal);
  }
  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 20px 20px;
  }
  .top {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--mid-gray);
  }
  .year {
    font-size: 11px;
    letter-spacing: 0.1em;
  }
  .topic {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--slate-teal);
  }
  .title {
    font-family: var(--display);
    font-size: 26px;
    font-weight: 600;
    line-height: 1.05;
    color: var(--deep-teal);
  }
  .text {
    flex: 1;
    font-size: 14px;
    line-height: 22px;
    color: var(--muted);
  }
  .more {
    font-size: 14px;
    font-weight: 600;
    color: var(--green-dark);
  }
</style>
