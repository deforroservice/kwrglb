---
import { darkCover } from '../lib/art';

interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  dark?: boolean;
  seed?: number;
}
const { title, subtitle, eyebrow, dark = false, seed = 2 } = Astro.props;
---

<section class:list={['hero', { dark }]} style={dark ? `background:${darkCover(seed)}` : undefined}>
  <div class="grid12">
    {eyebrow && <p class="label span-8">{eyebrow}</p>}
    <h1 class="span-8">{title}</h1>
    {subtitle && <p class="subtitle span-6">{subtitle}</p>}
    <div class="span-8 extra"><slot /></div>
  </div>
</section>

<style>
  .hero {
    padding: 56px 0 32px;
  }
  .label {
    margin: 0 0 12px;
  }
  h1 {
    margin: 0;
    font-size: 48px;
    font-weight: 700;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .subtitle {
    margin: 20px 0 0;
    font-size: 18px;
    line-height: 28px;
    color: var(--muted);
  }
  .extra:empty {
    display: none;
  }
  .extra {
    margin-top: 28px;
  }
  .dark {
    padding: 44px 0 48px;
    color: #fff;
  }
  .dark h1 {
    font-size: 44px;
  }
  .dark .subtitle {
    margin-top: 14px;
    font-size: 17px;
    line-height: 27px;
  }
  .dark .extra {
    margin-top: 22px;
  }
  .dark h1 {
    color: #fff;
  }
  .dark .label {
    color: var(--green);
  }
  .dark .subtitle {
    color: rgba(255, 255, 255, 0.85);
  }
  @media (min-width: 900px) {
    .hero {
      padding: 88px 0 40px;
    }
    h1 {
      font-size: 80px;
    }
    .dark {
      padding: 44px 0 48px;
    }
    .dark h1 {
      font-size: 56px;
    }
    /* Dark hero: headline left, text and buttons right */
    .dark .label {
      grid-column: 1 / span 7;
      grid-row: 1;
    }
    .dark h1 {
      grid-column: 1 / span 7;
      grid-row: 2 / span 2;
      align-self: start;
    }
    .dark .subtitle {
      grid-column: 8 / -1;
      grid-row: 2;
      margin-top: 4px;
    }
    .dark .extra {
      grid-column: 8 / -1;
      grid-row: 3;
    }
  }
</style>
