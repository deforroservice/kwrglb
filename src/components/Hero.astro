---
import { darkCover } from '../lib/art';
import Logo from './Logo.astro';

interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  dark?: boolean;
  seed?: number;
  // Home page: large faint logo mark behind the text and a wavy logo stripe along the bottom edge.
  brand?: boolean;
}
const { title, subtitle, eyebrow, dark = false, seed = 2, brand = false } = Astro.props;
---

<section class:list={['hero', { dark, brand }]} style={dark ? `background:${brand ? '#254657' : darkCover(seed)}` : undefined}>
  {brand && <Logo variant="mark" height={520} class="watermark" />}
  <div class="grid12">
    {eyebrow && <p class="label span-8">{eyebrow}</p>}
    <h1 class="span-8">{title}</h1>
    {subtitle && <p class="subtitle span-6">{subtitle}</p>}
    <div class="span-8 extra"><slot /></div>
  </div>
  {
    brand && (
      <svg class="stripe" viewBox="0 0 1200 24" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 14 C150 4 300 4 450 12 S750 22 900 12 S1100 4 1200 10" />
      </svg>
    )
  }
</section>

<style>
  .hero {
    padding: 56px 0 32px;
  }
  .label {
    margin: 0 0 12px;
  }
  h1 {
    margin: 0;
    font-size: 48px;
    font-weight: 700;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .subtitle {
    margin: 20px 0 0;
    font-size: 18px;
    line-height: 28px;
    color: var(--muted);
  }
  .extra:empty {
    display: none;
  }
  .extra {
    margin-top: 28px;
  }
  .brand {
    position: relative;
    overflow: hidden;
  }
  .brand .grid12 {
    position: relative;
  }
  .brand :global(.watermark) {
    position: absolute;
    right: -6%;
    top: 50%;
    width: auto;
    height: 140%;
    transform: translateY(-50%);
    opacity: 0.09;
    pointer-events: none;
  }
  .stripe {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 18px;
    fill: none;
    stroke: #5ede81;
    stroke-width: 3;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 6px rgba(94, 222, 129, 0.7));
  }
  .dark {
    padding: 44px 0 48px;
    color: #fff;
  }
  .dark h1 {
    font-size: 44px;
  }
  .dark .subtitle {
    margin-top: 16px;
    font-size: 18px;
    font-weight: 500;
    line-height: 28px;
  }
  .dark .extra {
    margin-top: 22px;
  }
  .dark h1 {
    color: #fff;
  }
  .dark .label {
    color: var(--green);
  }
  .dark .subtitle {
    color: var(--green);
  }
  @media (min-width: 900px) {
    .hero {
      padding: 88px 0 40px;
    }
    h1 {
      font-size: 80px;
    }
    .dark {
      padding: 44px 0 48px;
    }
    .dark h1 {
      font-size: 56px;
    }
    /* Dark hero: headline left, text and buttons right */
    .dark .label {
      grid-column: 1 / span 7;
      grid-row: 1;
    }
    .dark h1 {
      grid-column: 1 / span 7;
      grid-row: 2;
    }
    .dark .subtitle {
      grid-column: 1 / span 7;
      grid-row: 3;
      max-width: 58ch;
    }
    .dark .extra {
      grid-column: 8 / -1;
      grid-row: 2 / span 2;
      align-self: end;
      justify-self: end;
    }
  }
</style>
