---
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
}
const { title, subtitle, eyebrow } = Astro.props;
---

<section class="hero grid12">
  <div class="span-8">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
  </div>
  {
    subtitle && (
      <p class="subtitle span-6">{subtitle}</p>
    )
  }
  <div class="span-8"><slot /></div>
</section>

<style>
  .hero {
    padding-top: 64px;
    padding-bottom: 40px;
  }
  .eyebrow {
    margin: 0 0 8px;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  h1 {
    margin: 0;
    font-size: 44px;
    font-weight: 500;
    line-height: 48px;
    letter-spacing: -1px;
  }
  .subtitle {
    margin: 24px 0 0;
    font-size: 20px;
    font-weight: 500;
    line-height: 27px;
    letter-spacing: -0.5px;
  }
  @media (min-width: 900px) {
    .hero {
      padding-top: 120px;
      padding-bottom: 48px;
    }
    h1 {
      font-size: 64px;
      line-height: 72px;
      letter-spacing: -1.5px;
    }
  }
</style>
